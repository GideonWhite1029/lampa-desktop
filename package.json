{
  "name": "lampa",
  "productName": "Lampa",
  "version": "1.6.1",
  "description": "Приложение для просмотров фильмов и сериалов",
  "repository": {
    "type": "git",
    "url": "https://github.com/GideonWhite1029/lampa-desktop"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make-x64-win32": "electron-forge make --arch=x64 --platform=win32",
    "make-x64-linux": "electron-forge make --arch=x64 --platform=linux",
    "make": "electron-forge make",
    "publish-x64-win32": "electron-forge publish --arch=x64 --platform=win32",
    "publish-x64-linux": "electron-forge publish --arch=x64 --platform=linux",
    "lint": "echo \"No linting configured\""
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-flatpak": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-wix": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@reforged/maker-appimage": "^5.3.1",
    "electron": "^44.5.1"
  },
  "author": {
    "name": "ymata, GideonWhite1029",
    "email": "gideonwhite1029@gmail.com"
  },
  "license": "GPL-2.0",
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "overrides": {
    "@reforged/maker-appimage": {
      "@electron/rebuild": "^4.2.0",
      "@electron-forge/maker-base": "^8.0.1"
    }
  }
}
